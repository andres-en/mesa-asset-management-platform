# Backend-only configuration (running Flask locally or backend/docker-compose.yml).
# Copy to backend/.env and adjust the values.

# Flask
FLASK_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Required (no fallback) when FLASK_ENV=production.
SECRET_KEY=change-this-secret-key
JWT_SECRET_KEY=change-this-jwt-secret-key

# Database
DATABASE_URL=postgresql://mesa:mesa@db:5432/mesa
POSTGRES_USER=mesa
POSTGRES_PASSWORD=mesa
POSTGRES_DB=mesa

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# CORS (allowed frontend origins, comma-separated)
CORS_ORIGINS=http://localhost:3000

# SMTP (outgoing email for remote-signature links)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=Mesa <your-address@example.com>

# Remote signature link (frontend page that serves /firmar/:token)
SIGNING_BASE_URL=http://localhost:3000/firmar
SIGNATURE_TOKEN_EXPIRATION_HOURS=48

# Uploads
UPLOAD_FOLDER=uploads/firmas
