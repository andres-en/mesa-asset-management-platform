# Full stack (docker-compose.yml at the repository root: PostgreSQL + Flask API + Next.js).
# Copy to .env in this folder and adjust the values before `docker compose up`.

FLASK_ENV=production
# Required. Generate each with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=
# Set to true when serving over HTTPS.
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_DOMAIN=

# PostgreSQL
POSTGRES_USER=mesa
POSTGRES_PASSWORD=mesa
POSTGRES_DB=mesa
DB_PORT=5433

# Google OAuth (backend: code exchange / frontend: sign-in button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# SMTP (outgoing email for remote-signature links)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# URLs / ports
CORS_ORIGINS=http://localhost:3000
SIGNING_BASE_URL=http://localhost:3000/firmar
SIGNATURE_TOKEN_EXPIRATION_HOURS=48
# Baked into the frontend bundle at build time: must be reachable from the user's browser.
NEXT_PUBLIC_API_URL=http://localhost:5000
# Enables a mock login in the frontend for UI work without a backend. Keep false.
NEXT_PUBLIC_ENABLE_DEV_LOGIN=false
WEB_PORT=5000
FRONTEND_PORT=3000
